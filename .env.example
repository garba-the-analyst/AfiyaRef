# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://afiyaref:afiyaref@localhost:5432/afiyaref?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Nurse Titi LLM (Ollama Cloud free tier by default; set LLM_PROVIDER=openai to use OpenAI)
LLM_PROVIDER="ollama"
OLLAMA_API_KEY=""
OLLAMA_MODEL="gpt-oss:20b"
OLLAMA_BASE_URL="https://ollama.com"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# WhatsApp - Meta Cloud API
WHATSAPP_VERIFY_TOKEN="afiyaref-verify-token"
WHATSAPP_ACCESS_TOKEN="EAAG..."
WHATSAPP_API_VERSION="v21.0"
# minimalist = Nurse Titi + nearby finder only; full = all 4 menu flows
WHATSAPP_MODE="full"
# meta = Meta Cloud API (production) | baileys = local linked-device testing, no Meta needed
WHATSAPP_PROVIDER="meta"
# digits only — Baileys prints an 8-digit pairing code instead of a QR (leave empty for QR)
WHATSAPP_PAIR_NUMBER=""
# Optional: Twilio fallback
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

PORT=3000
NODE_ENV=development
ADMIN_API_KEY="generate-with-openssl-rand-hex-24"
